<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页骨架。与字号版本相关的尺寸/字号在 SettingsActivity.applyTokens() 里按令牌设置，
  这里只保留与版本无关的结构。分组顺序：显示 / 定位 / 数据 / 关于。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xt_paper"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/xt_ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="设置"
            android:textColor="@color/xt_ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settingsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/gDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示" />

            <LinearLayout
                android:id="@+id/groupDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowFont"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tFont"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="大字模式" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Switch
                        android:id="@+id/switchLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:showText="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/gLocate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="定位" />

            <LinearLayout
                android:id="@+id/groupLocate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowPerm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tPerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="定位权限" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/vPerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/chevPerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/gData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据" />

            <LinearLayout
                android:id="@+id/groupData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除缓存" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/vCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/chevCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/gAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于" />

            <LinearLayout
                android:id="@+id/groupAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="版本" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/vVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
